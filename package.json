{
  "name": "damco-v",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vscode": "npm --prefix extension run build && node test/vscode/run.mjs",
    "test:vscode:noibmi": "npm --prefix extension run build && node test/vscode/run.mjs --without-ibmi",
    "corpus:fetch": "node test/corpus/fetch.mjs",
    "sample:generate": "python test/sample-root/generate.py test/sample-root",
    "accuracy": "node test/accuracy/report.mjs",
    "accuracy:update": "node test/accuracy/report.mjs --update"
  },
  "devDependencies": {
    "vite": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "monaco-editor": "^0.47.0"
  }
}
